# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored and must never be committed.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
# Local development example (default postgres superuser / your password):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sih26033

# --- JWT ----------------------------------------------------------------------
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-me-with-a-long-random-secret-string

# HS256 is a good default. Don't change unless you know what you are doing.
JWT_ALGORITHM=HS256

# How long an access token stays valid (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origin allowed by FastAPI CORS during local development.
FRONTEND_ORIGIN=http://localhost:5173

# CEDA Agri Market API. Put the real bearer token only in your untracked .env.
CEDA_API_KEY=
CEDA_API_BASE_URL=https://api.ceda.ashoka.edu.in/v1
